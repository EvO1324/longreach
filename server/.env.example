# Example settings for the API. npm run setup writes the real server/.env;
# copy this by hand only if you'd rather fill it in yourself.

# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=

# Infinite Flight API key (from Infinite Flight's developer programme)
IF_API_KEY=

# Sign-in tokens: a long random string
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# The crew centre's address(es), comma-separated
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Owner emails: full admin access
DEVELOPER_EMAILS=

# true while testing locally: no scheduled jobs (Discord posts, activity checks)
DISABLE_JOBS=true
